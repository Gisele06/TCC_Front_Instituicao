# Copie este arquivo para .env e preencha os dados do ambiente.
# As variáveis VITE_ são públicas no navegador. Nunca use client_secret aqui.
# Padrão: mock (telas preenchidas e cadastros locais).
# Quando o backend estiver pronto, mude para api e configure a URL abaixo.
VITE_FONTE_DADOS=mock
VITE_API_BASE_URL=
# IDs abaixo são apenas para desenvolvimento; a autorização deve ser feita no backend.
VITE_INSTITUICAO_ID=
VITE_FUNCIONARIO_ID=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=
VITE_DEMO_MODE=true
